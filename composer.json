{
  "name": "mykholy/laravel-leakproof",
  "description": "Detect sensitive data and AI API key leaks in Laravel JSON responses with PHPUnit assertions, CLI scanner and optional middleware.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "laravel-package",
    "laravel-security",
    "api-security",
    "json-api",
    "security-testing",
    "sensitive-data",
    "data-leak-prevention",
    "phpunit",
    "api-testing",
    "privacy",
    "php",
    "ai-security",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "api-key-detection",
    "secret-scanning"
  ],
  "homepage": "https://github.com/mykholy/laravel-leakproof",
  "authors": [
    {
      "name": "Ahmed Elkholy",
      "homepage": "https://github.com/mykholy",
      "role": "Maintainer"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-ctype": "*",
    "ext-json": "*",
    "illuminate/console": "^12.0 || ^13.0",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/routing": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Mykholy\\LeakProof\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mykholy\\LeakProof\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mykholy\\LeakProof\\LeakProofServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "format": "pint",
    "format-check": "pint --test",
    "smoke": "@php tools/smoke.php",
    "benchmark": "@php tools/benchmark.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
