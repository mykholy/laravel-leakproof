{
  "name": "mykholy/laravel-leakproof",
  "description": "Catch sensitive data leaking into Laravel JSON API responses before deployment.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "security",
    "api",
    "privacy",
    "testing",
    "sensitive-data",
    "json"
  ],
  "homepage": "https://github.com/mykholy/laravel-leakproof",
  "authors": [
    {
      "name": "Ahmed Elkholy",
      "homepage": "https://github.com/mykholy",
      "role": "Maintainer"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "illuminate/console": "^11.0 || ^12.0 || ^13.0",
    "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
    "illuminate/http": "^11.0 || ^12.0 || ^13.0",
    "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Mykholy\\LeakProof\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mykholy\\LeakProof\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mykholy\\LeakProof\\LeakProofServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "format": "pint",
    "format-check": "pint --test",
    "smoke": "@php tools/smoke.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
